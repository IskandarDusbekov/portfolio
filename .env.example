# Bu fayldan nusxa oling: cp .env.example .env
# Keyin qiymatlarni o'zingiznikiga moslang. .env fayli git'ga QO'SHILMAYDI.

# Xavfsizlik uchun uzun, tasodifiy kalit qo'ying (pastda generatsiya buyrug'i bor)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Productionda (serverda) MAJBURIY False bo'lsin
DJANGO_DEBUG=False

# Domenlaringiz, vergul bilan ajrating (http:// yozmang)
DJANGO_ALLOWED_HOSTS=iskandarcoder.uz,www.iskandarcoder.uz

# CSRF uchun to'liq origin (https:// bilan)
DJANGO_CSRF_TRUSTED_ORIGINS=https://iskandarcoder.uz,https://www.iskandarcoder.uz
